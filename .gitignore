# ===================================
# SeaHunter Project .gitignore
# ===================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
*.whl

# Virtual Environment
venv/
env/
ENV/
.venv
.venv/
.uv-cache/
.uv-python/
.runtime/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# Jupyter Notebook
.ipynb_checkpoints
*.ipynb

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# ===================================
# Project-Specific
# ===================================

# Datasets (too large to upload)
/datasets/
/data/
*.zip
*.tar.gz
*.rar

# Training Results & Logs
runs/
wandb/
logs/
mlruns/
artifacts/
recordings/
evidence/

# Pretrained Weights (download separately)
*.pt
*.pth
*.onnx
*.engine
*.plan
*.trt
*.tflite
*.pb
# Keep explicitly registered baseline weights during M0.
!yolov8s.pt
!weights/seahunter_best.pt

# Temporary Files
temp/
tmp/
*.tmp
*.jsonl
*.parquet

# Paper & Visualizations (optional, can be included)
# paper_visualizations/*.png
# paper_visualizations/*.pdf

# LaTeX Compilation Files
*.aux
*.log
*.out
*.toc
*.bbl
*.blg
*.synctex.gz
*.fdb_latexmk
*.fls

# Git
.git/
*.orig
